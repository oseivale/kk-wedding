# Copy this file to .env.local (or add these in your host's dashboard, e.g. Vercel → Settings → Environment Variables).
# Leave APPS_SCRIPT_URL empty to run in demo mode: forms work, nothing is saved, and the code DEMO2027 is accepted.

# The single invitation code. It's in both invitation emails and unlocks the RSVP and the
# gated pages (wedding details, travel, FAQ, gifts). Case-insensitive.
INVITE_CODE=

# A long random string used to sign the "unlocked" cookie. Generate one the same way as below.
# Changing it (or INVITE_CODE) locks every device out until the code is entered again.
ACCESS_SECRET=

# Web app URL from Google Apps Script (Deploy → New deployment → Web app). Ends in /exec.
APPS_SCRIPT_URL=

# A long random string. Must match SHARED_SECRET in the Apps Script's Script Properties.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPS_SCRIPT_SECRET=
